# local.zsh — machine-specific overrides
#
# Copy to `local.zsh` (gitignored) and customise. Sourced last from .zshrc,
# so anything here overrides the committed config.

# ---------- OS detection ----------
case "$OSTYPE" in
  linux-gnu*)
    if grep -qiE '(microsoft|wsl)' /proc/version 2>/dev/null; then
      OS=wsl
    else
      OS=linux
    fi
    ;;
  darwin*) OS=mac ;;
  *)       OS=other ;;
esac

# ---------- Linux / WSL only ----------
if [[ "$OS" != "mac" ]]; then
  alias open='xdg-open'
fi

# ---------- PATH extensions ----------
